__pycache__/
*.pyc
.venv/
.venv-tflite/
venv/
.tool_appdata/
.tool_localappdata/

# Raw video dataset files
ml/data_raw/videos/**/*
*.mp4
*.avi
*.mov
*.mkv

# Processed dataset outputs
ml/data_processed/landmarks/**/*
*.npy
*.npz

# Phone-camera pilot landmark samples
ml/data_phone/landmark_samples/**/*.json
ml/data_phone/imported_landmarks/**/*.json
ml/data_phone/imported_landmarks/import_status.json
!ml/data_phone/landmark_samples/.gitkeep
!ml/data_phone/imported_landmarks/.gitkeep

# Local phone dataset fixtures and backups
ml/data_phone/fixtures/**/*.json
ml/data_phone/*_backup*.zip
ml/data_phone/invalidated_backups/*.zip

# Local MediaPipe model assets
ml/models/*.task

# Trained model binaries
ml/models/**/*.joblib
*.keras
*.h5
*.tflite
*.pb
ml/models/**/saved_model/**/*

# Flutter runtime model assets required by Sprint 2.14 prototype
!flutter_app/assets/models/model_float32.tflite
!flutter_app/assets/models/model_dynamic_range.tflite
!flutter_app/assets/models/signsync_40class_account_corrected_v2_float32.tflite
!flutter_app/assets/models/signsync_40class_account_corrected_v2_dynamic_range.tflite

# Local pre-deployment model backups
flutter_app/assets/model_backups/

# Do not push report/documentation files
/docs/

# Do not push laptop camera raw recordings
/ml/data_raw/videos/

# Local temporary files and unrelated generated release archives
/tmp/
/releases/SignSync_RC1/app/*.apk
/releases/SignSync_RC1/SignSync_RC1_Evidence.zip
/releases/SignSync_RC1/SignSync_RC1_Source.zip
